{
  "name": "localcut",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --base=/",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "build:root": "node scripts/build.mjs --root",
    "preview": "vite preview --port 4178 --strictPort",
    "test:browser": "node scripts/test-browser.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "test:transcription": "playwright test --project=acceptance --grep @transcription",
    "test:performance": "playwright test --project=acceptance --grep @performance",
    "test:ai:live": "playwright test --config playwright.ai-live.config.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check": "node scripts/check.mjs",
    "test:profile": "node scripts/profile-tests.mjs",
    "test:tooling": "node --test tests/tooling/*.test.mjs",
    "test:safari": "node scripts/test-safari.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@huggingface/transformers": "4.3.1",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "fflate": "0.8.2",
    "idb": "8.0.4",
    "lucide-react": "1.53.0",
    "mediabunny": "1.61.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.14.3",
    "react-router": "8.4.0",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
